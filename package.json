{
  "name": "multiplayer-web-games",
  "private": true,
  "version": "0.1.0",
  "description": "Game Night — a hub of browser multiplayer party games",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-games.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "tsx server/index.ts",
    "start:prod": "node dist/server/index.js",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "voices": "tsx scripts/generate-voices.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "@dimforge/rapier3d-compat": "^0.12.0",
    "colyseus.js": "^0.16.22",
    "express": "^5.3.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
