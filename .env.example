# Copy to .env for local development. Every value is optional: the games run without them.
# On a host (EasyPanel, Render, Fly…), set the same variables in the service's environment.

# ElevenLabs text-to-speech for the KASALA announcer.
# Optional: the 95 lines are pre-rendered and committed, so the game speaks without a key.
# A key is needed to render new/changed lines (`npm run voices`) or to let the hub synthesize on demand.
ELEVENLABS_API_KEY=

# Cemil Abi: Istanbul-accented Adam (the default for KASALA).
ELEVENLABS_VOICE_KASALA=J17lijyP1BHYcM7ld0Rg
# Default voice for any other game/character that asks for synthesis (Adam, deep).
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_v4
# ELEVENLABS_TTS_DISABLED=1

# Where the hub caches on-demand mp3s (default .voice-cache).
# VOICE_CACHE_DIR=.voice-cache
